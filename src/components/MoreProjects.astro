---
import ArrowLink from './ArrowLink.astro';
import { moreProjects } from '../data/projects';
---

<div class="mt-14">
  <h3 class="reveal text-sm font-medium tracking-widest text-muted uppercase">More projects</h3>

  <ul class="mt-4 border-t border-border">
    {
      moreProjects.map((p) => (
        <li class="reveal flex flex-col gap-3 border-b border-border py-5 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
          <div class="min-w-0">
            <h4 class="font-display text-xl tracking-tight">{p.title}</h4>
            <p class="mt-1 leading-relaxed text-muted">{p.description}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {p.tags.map((t) => (
                <li class="rounded-md bg-bg px-2 py-1 text-xs text-muted ring-1 ring-border">{t}</li>
              ))}
            </ul>
          </div>
          <div class="flex shrink-0 gap-4 sm:pt-1">
            {p.links.map((l) => (
              <ArrowLink href={l.href}>{l.label}</ArrowLink>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</div>
