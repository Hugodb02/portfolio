---
import { site } from '../data/site';
---

<section id="top" class="mx-auto max-w-5xl px-6 pt-20 pb-24 sm:pt-28 sm:pb-32">
  <p class="reveal text-sm font-medium tracking-widest text-accent uppercase">
    {site.title} · Ghent, Belgium
  </p>

  <h1 class="reveal mt-5 font-display text-[clamp(2.75rem,8vw,5.75rem)] leading-[1.02] font-light tracking-tight">
    Hugo De Bosschere
  </h1>

  <p class="reveal mt-6 max-w-2xl text-xl leading-relaxed text-ink/90 sm:text-2xl">
    {site.tagline}
  </p>

  <p class="reveal mt-4 max-w-xl leading-relaxed text-muted">
    {site.intro}
  </p>

  <div class="reveal mt-9 flex flex-wrap items-center gap-3">
    <a
      href={site.cv}
      class="rounded-full bg-accent px-6 py-3 text-sm font-medium text-accent-ink transition-opacity hover:opacity-90"
    >
      Download CV
    </a>
    <a
      href="#contact"
      class="rounded-full border border-border px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-surface"
    >
      Get in touch
    </a>
  </div>

  <div class="reveal mt-8 flex items-center gap-5">
    <a
      href={site.github}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ink"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.73-1.56-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"></path>
      </svg>
      GitHub
    </a>
    <a
      href={site.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ink"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path>
      </svg>
      LinkedIn
    </a>
  </div>
</section>
