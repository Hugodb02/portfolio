---
import SectionHeading from './SectionHeading.astro';
import { skillGroups } from '../data/skills';
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
  <SectionHeading eyebrow="Skills" title="My toolbox." />

  <dl class="mt-12 space-y-8">
    {
      skillGroups.map((group) => (
        <div class="reveal grid gap-3 sm:grid-cols-[160px_1fr] sm:gap-8">
          <dt class="text-sm font-medium tracking-wide text-muted uppercase sm:pt-1">{group.label}</dt>
          <dd>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-lg border border-border bg-surface px-3 py-1.5 text-sm text-ink/90">
                  {item}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
