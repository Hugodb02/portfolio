---
import { site } from '../data/site';

const rows = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', value: '/in/hugo-de-bosschere', href: site.linkedin, external: true },
  { label: 'GitHub', value: '/Hugodb02', href: site.github, external: true },
  { label: 'Phone', value: site.phone, href: `tel:${site.phoneHref}` },
  { label: 'Resume', value: 'Download PDF ↓', href: site.cv },
];

const fieldClass =
  'mt-1.5 w-full rounded-xl border border-border bg-bg px-4 py-3 text-ink placeholder:text-muted/70 transition-colors focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/40';
const labelClass = 'text-xs font-medium tracking-widest text-muted uppercase';
---

<section id="contact" class="relative overflow-hidden border-t border-border bg-surface">
  <!-- warm accent glow, manudevloo style -->
  <div
    class="pointer-events-none absolute -top-40 -left-40 h-[28rem] w-[28rem] rounded-full bg-accent/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <p class="reveal flex items-center gap-3 text-sm font-medium tracking-widest text-accent uppercase">
      <span class="h-px w-8 bg-accent"></span>06 / Let's connect
    </p>

    <h2 class="reveal mt-6 font-display text-[clamp(2.5rem,7vw,4.75rem)] leading-[1.02] tracking-tight">
      Have something <span class="text-accent italic">worth building?</span>
    </h2>

    <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Left: intro + contact details -->
      <div class="reveal">
        <p class="max-w-md text-lg leading-relaxed text-muted">
          Whether you're hiring for a junior role, need an extra pair of hands on a project, or just
          want to talk, I'd be glad to hear from you.
        </p>

        <dl class="mt-10 border-t border-border">
          {
            rows.map((r) => (
              <div class="flex flex-col gap-1 border-b border-border py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <dt class="text-xs tracking-widest text-muted uppercase">{r.label}</dt>
                <dd class="min-w-0">
                  <a
                    href={r.href}
                    {...r.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                    class="break-all text-ink underline-offset-4 transition-colors hover:text-accent hover:underline sm:break-normal"
                  >
                    {r.value}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-6 text-sm text-muted">
          Based in {site.location} · Open to junior roles and internships
        </p>
      </div>

      <!-- Right: message form (opens your email app, no tracking) -->
      <form data-contact data-email={site.email} class="reveal rounded-2xl border border-border bg-bg/40 p-5 sm:p-7" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class={labelClass} for="cf-name">Your name</label>
            <input class={fieldClass} id="cf-name" name="name" type="text" autocomplete="name" placeholder="Jane Doe" required />
          </div>
          <div>
            <label class={labelClass} for="cf-email">Email</label>
            <input class={fieldClass} id="cf-email" name="email" type="email" autocomplete="email" placeholder="jane@company.com" required />
          </div>
        </div>

        <div class="mt-5">
          <label class={labelClass} for="cf-subject">Subject</label>
          <input class={fieldClass} id="cf-subject" name="subject" type="text" placeholder="Role, project, or just a hello" />
        </div>

        <div class="mt-5">
          <label class={labelClass} for="cf-message">Message</label>
          <textarea class={`${fieldClass} min-h-40 resize-y`} id="cf-message" name="message" placeholder="Tell me what you're working on and how I can help." required></textarea>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button
            type="submit"
            class="group inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-medium text-accent-ink transition-opacity hover:opacity-90"
          >
            Send message
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </button>
          <span class="text-xs text-muted">Opens in your email app.</span>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.querySelector('form[data-contact]');
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const to = form.getAttribute('data-email');
      const data = new FormData(form);
      const subject = (data.get('subject') || 'Portfolio enquiry').toString();
      const body =
        `Name: ${data.get('name') || ''}\n` +
        `Email: ${data.get('email') || ''}\n\n` +
        `${data.get('message') || ''}`;
      window.location.href =
        `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  })();
</script>
