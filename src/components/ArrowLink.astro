---
interface Props {
  href: string;
}
const { href } = Astro.props;
const external = href.startsWith('http');
---

<a
  href={href}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  class="group inline-flex items-center gap-1.5 text-sm font-medium text-ink transition-colors hover:text-accent"
>
  <slot />
  <svg
    class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M7 17 17 7M9 7h8v8"></path>
  </svg>
</a>
