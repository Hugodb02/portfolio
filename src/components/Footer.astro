---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-surface">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 border-t border-border px-6 py-8 text-sm text-muted sm:flex-row">
    <p>© {year} {site.name}</p>
    <p>
      Built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-ink transition-colors hover:text-accent">Astro</a>
      &amp;
      <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="text-ink transition-colors hover:text-accent">Tailwind</a>
    </p>
  </div>
</footer>
